{
  "seed": 7,
  "model": {
    "task_type": "sequence_classification",
    "model_name": "distilbert-base-uncased",
    "max_length": 128,
    "gradient_checkpointing": false
  },
  "dataset": {
    "dataset_name": "ag_news",
    "dataset_config_name": null,
    "train_split": "train[:2%]",
    "eval_split": "test[:2%]",
    "text_column": "text",
    "label_column": "label"
  },
  "lora": {
    "enabled": true,
    "target_modules": ["q_lin", "v_lin"],
    "rank": 8,
    "alpha": 16.0,
    "dropout": 0.05
  },
  "training": {
    "output_dir": "outputs/distilbert_agnews",
    "device": "auto",
    "use_fp16": true,
    "num_steps": 30,
    "batch_size": 8,
    "eval_batch_size": 8,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.0002,
    "weight_decay": 0.0,
    "warmup_steps": 5,
    "log_interval": 5,
    "eval_interval": 15,
    "max_eval_batches": 20
  },
  "quant_regularization": {
    "enable_quant_lora_regularization": true,
    "lambda_q": 0.02,
    "quantizer_type": "uniform_per_channel",
    "bit_width": 4,
    "group_size": 16,
    "regularization_frequency": 1,
    "log_per_layer_stats": false
  }
}
