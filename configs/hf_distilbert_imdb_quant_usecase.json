{
  "seed": 7,
  "model": {
    "task_type": "sequence_classification",
    "model_name": "distilbert-base-uncased",
    "max_length": 256,
    "gradient_checkpointing": false
  },
  "dataset": {
    "dataset_name": "imdb",
    "dataset_config_name": null,
    "train_split": "train",
    "eval_split": "test",
    "max_train_samples": 5000,
    "max_eval_samples": 5000,
    "format_style": "plain_text",
    "text_column": "text",
    "label_column": "label"
  },
  "lora": {
    "enabled": true,
    "target_modules": ["q_lin", "k_lin", "v_lin", "out_lin"],
    "rank": 8,
    "alpha": 16.0,
    "dropout": 0.05
  },
  "training": {
    "output_dir": "outputs/distilbert_imdb_quant_usecase",
    "device": "auto",
    "use_fp16": true,
    "num_steps": 300,
    "batch_size": 12,
    "eval_batch_size": 24,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.0002,
    "weight_decay": 0.0,
    "warmup_steps": 20,
    "log_interval": 25,
    "eval_interval": 50,
    "max_eval_batches": null
  },
  "quant_regularization": {
    "enable_quant_lora_regularization": true,
    "lambda_q": 0.005,
    "quantizer_type": "uniform_per_channel",
    "bit_width": 4,
    "group_size": 16,
    "regularization_frequency": 1,
    "log_per_layer_stats": false
  }
}
