{
  "seed": 7,
  "model": {
    "task_type": "causal_lm",
    "model_name": "gpt2",
    "max_length": 192,
    "gradient_checkpointing": true
  },
  "dataset": {
    "dataset_name": "databricks/databricks-dolly-15k",
    "dataset_config_name": null,
    "train_split": "train[:30%]",
    "eval_split": "train[90%:95%]",
    "format_style": "instruction_response",
    "text_column": "instruction",
    "label_column": "label",
    "prompt_column": "instruction",
    "response_column": "response",
    "context_column": "context",
    "mask_prompt_tokens": true
  },
  "lora": {
    "enabled": true,
    "target_modules": ["c_attn", "c_proj", "c_fc"],
    "rank": 8,
    "alpha": 16.0,
    "dropout": 0.05
  },
  "training": {
    "output_dir": "outputs/gpt2_dolly_quant_usecase",
    "device": "auto",
    "use_fp16": true,
    "num_steps": 180,
    "batch_size": 2,
    "eval_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "warmup_steps": 10,
    "log_interval": 20,
    "eval_interval": 60,
    "max_eval_batches": null,
    "generation_prompts": [
      "Instruction:\nDraft a polite reply to a customer asking for a refund because their package arrived damaged.\n\nResponse:\n",
      "Instruction:\nSummarize why regularization can help machine learning models generalize better.\n\nResponse:\n",
      "Instruction:\nWrite a short internal helpdesk response explaining how to reset a forgotten password.\n\nResponse:\n"
    ],
    "generation_max_new_tokens": 80,
    "generation_temperature": 0.8,
    "generation_top_p": 0.95
  },
  "quant_regularization": {
    "enable_quant_lora_regularization": true,
    "lambda_q": 0.002,
    "quantizer_type": "uniform_groupwise",
    "bit_width": 4,
    "group_size": 64,
    "regularization_frequency": 1,
    "log_per_layer_stats": false
  }
}
