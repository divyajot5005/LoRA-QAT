{
  "seed": 7,
  "model": {
    "task_type": "causal_lm",
    "model_name": "Qwen/Qwen2.5-7B-Instruct",
    "max_length": 512,
    "gradient_checkpointing": true,
    "torch_dtype": "bfloat16",
    "attn_implementation": "sdpa"
  },
  "dataset": {
    "dataset_name": "code_search_net",
    "dataset_config_name": "python",
    "train_split": "train",
    "eval_split": "validation",
    "max_train_samples": 20000,
    "max_eval_samples": 2000,
    "format_style": "plain_text",
    "text_column": "func_code_string",
    "label_column": "label",
    "prompt_column": null,
    "response_column": null,
    "context_column": null,
    "mask_prompt_tokens": false
  },
  "lora": {
    "enabled": true,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "rank": 16,
    "alpha": 32.0,
    "dropout": 0.05
  },
  "training": {
    "output_dir": "C:\\Work\\Papers\\Quantization-through-LoRA\\outputs\\h100_suite_smoke\\runs\\qwen25_7b__domain_adaptation_code__quant_fp8_ft",
    "device": "auto",
    "mixed_precision": "bf16",
    "num_steps": 300,
    "batch_size": 2,
    "eval_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "warmup_steps": 15,
    "log_interval": 30,
    "eval_interval": 60,
    "max_eval_batches": null,
    "generation_prompts": [
      "def moving_average(values, window):\n",
      "class CustomerRecord:\n    def __init__(self, name, email):\n",
      "def format_currency(amount):\n"
