{
  "seed": 7,
  "model": {
    "task_type": "causal_lm",
    "model_name": "sshleifer/tiny-gpt2",
    "max_length": 64,
    "gradient_checkpointing": false,
    "torch_dtype": "float32",
    "attn_implementation": null
  },
  "dataset": {
    "dataset_name": "wikitext",
    "dataset_config_name": "wikitext-2-raw-v1",
    "train_split": "train[:8]",
    "eval_split": "validation[:8]",
    "max_train_samples": 8,
    "max_eval_samples": 8,
    "format_style": "plain_text",
    "text_column": "text",
    "label_column": "label",
    "prompt_column": null,
    "response_column": null,
    "context_column": null,
    "mask_prompt_tokens": false,
    "num_proc": 1
  },
  "lora": {
    "enabled": true,
    "target_modules": [
      "c_attn",
      "c_proj"
    ],
    "rank": 2,
    "alpha": 4.0,
    "dropout": 0.0
  },
  "training": {
    "output_dir": "outputs/logit_kl_smoke",
    "device": "cpu",
    "mixed_precision": "no",
    "num_steps": 1,
    "batch_size": 2,
    "eval_batch_size": 2,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "warmup_steps": 0,
    "log_interval": 1,
    "eval_interval": 1,
    "max_eval_batches": 1,
    "generation_prompts": [],
    "generation_max_new_tokens": 16,
    "generation_temperature": 0.8,
    "generation_top_p": 0.95
  },
  "quant_regularization": {
    "enable_quant_lora_regularization": true,
    "lambda_q": 1.0,
    "quantizer_type": "uniform_groupwise",
    "bit_width": 4,
    "group_size": 16,
    "regularization_objective": "logit_kl",
    "logit_kl_temperature": 1.0,
    "regularization_frequency": 1,
    "detach_layer_inputs": true,
    "max_activation_regularized_layers": 0,
    "log_per_layer_stats": false
  }
}