{
  "seed": 7,
  "model": {
    "task_type": "causal_lm",
    "model_name": "Qwen/Qwen2.5-7B-Instruct",
    "max_length": 384,
    "gradient_checkpointing": true,
    "torch_dtype": "bfloat16",
    "attn_implementation": "sdpa"
  },
  "dataset": {
    "dataset_name": "bitext/Bitext-customer-support-llm-chatbot-training-dataset",
    "dataset_config_name": null,
    "train_split": "train[:35%]",
    "eval_split": "train[90%:95%]",
    "max_train_samples": 10000,
    "max_eval_samples": 1500,
    "format_style": "instruction_response",
    "text_column": "instruction",
    "label_column": "label",
    "prompt_column": "instruction",
    "response_column": "response",
    "context_column": null,
    "mask_prompt_tokens": true
  },
  "lora": {
    "enabled": true,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "rank": 16,
    "alpha": 32.0,
    "dropout": 0.05
  },
  "training": {
    "output_dir": "outputs/h100_suite/runs/qwen25_7b__customer_support__no_quant_ft",
    "device": "auto",
    "mixed_precision": "bf16",
    "num_steps": 300,
    "batch_size": 2,
    "eval_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "warmup_steps": 15,
    "log_interval": 30,
    "eval_interval": 60,
    "max_eval_batches": null,
    "generation_prompts": [
      "Instruction:\nquestion about cancelling order 81342\n\nResponse:\n",
      "Instruction:\nneed help tracking delayed package 55201\n\nResponse:\n",
      "Instruction:\nrequesting refund because product arrived defective\n\nResponse:\n"
    ],
    "generation_max_new_tokens": 96,
    "generation_temperature": 0.7,
    "generation_top_p": 0.9
  },
  "quant_regularization": {
    "enable_quant_lora_regularization": false,
    "lambda_q": 0.0,
    "quantizer_type": "uniform_groupwise",
    "bit_width": 4,
    "group_size": 128,
    "regularization_frequency": 1,
    "log_per_layer_stats": false
  }
}